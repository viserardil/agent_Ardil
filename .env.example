# AgentArdil ortam değişkenleri.
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldur:  cp .env.example .env
# .env asla commit'lenmez (bkz. .gitignore).

# ===========================================================================
# LLM — ana model (triyaj + şeritler). Sağlayıcı-bağımsız; çoğu sağlayıcı
# OpenAI-uyumlu bir endpoint sunar, o yüzden aşağıdaki 3 satırı doldurman yeter.
# ===========================================================================
LLM_API_KEY=buraya_anahtarini_yaz
LLM_MODEL=gpt-4.1
LLM_BASE_URL=https://api.openai.com/v1

# Örnek — Gemini:
#   LLM_MODEL=gemini-2.5-flash
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Örnek — Groq:
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_BASE_URL=https://api.groq.com/openai/v1

# Sağlayıcı structured output'ta json_schema desteklemiyorsa:
#   LLM_STRUCTURED_METHOD=function_calling
# İsteğe bağlı ince ayarlar (varsayılanları vardır):
#   TEMPERATURE=0.1
#   MAX_TOKENS=4096
#   LLM_TIMEOUT=90
#   LLM_MAX_RETRIES=2

# Triyaj için ayrı/daha hızlı bir model kullanmak istersen (boşsa ana model):
#   TRIAGE_MODEL=gpt-4.1-mini

# ===========================================================================
# Araçlar
# ===========================================================================
# web_search aracı (Tavily) — güncel web araması için:
TAVILY_API_KEY=buraya_tavily_anahtarini_yaz

# ===========================================================================
# Ses tanıma (STT) — Groq Whisper
# ===========================================================================
GROQ_API_KEY=buraya_groq_anahtarini_yaz

# Dili Türkçe'ye SABİTLE. Otomatik tespit (boş bırakmak) Türkçe konuşmayı
# İngilizce'ye çevirebiliyor; "tr" bunu engeller.
STT_LANGUAGE=tr

# Türkçe'de daha isabetli. Not: "whisper-large-v3-turbo" hızlı ama Türkçe'de
# sık sık İngilizce'ye kaçtığı için tam sürüm tercih edildi.
STT_MODEL=whisper-large-v3

# İsteğe bağlı:
#   STT_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions

# ===========================================================================
# Sesli çıktı (TTS) — Coqui XTTS-v2 (opsiyonel, ana venv'de süreç içi)
# ===========================================================================
# "Sesli çıktı" modu açıkken cevap XTTS-v2 ile seslendirilir. Ayrı servis/venv
# YOK: model aynı süreçte ilk sesli istekte tembel yüklenir. Kurulum için README >
# "Sesli çıktı (TTS)" bölümüne bak. Değişiklik için sunucuyu yeniden başlat.
#
# Sentez dili (XTTS 17 dil destekler):
#   TTS_LANGUAGE=tr
# Yerleşik konuşmacı (XTTS-v2'de 58 seçenek; ör. Daisy Studious, Gracie Wise...):
#   TTS_SPEAKER=Claribel Dervla
# Kendi sesini KLONLAMAK için kısa bir referans wav yolu (verilirse TTS_SPEAKER
# yok sayılır):
#   TTS_SPEAKER_WAV=C:\yol\referans.wav
# Model (varsayılan XTTS-v2):
#   TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
#
# --- Parçalama (uzun cevaplar cümle sınırında parçalanır) ---
#   TTS_CHUNK_TOKENS=120   # parça başına ~token bütçesi
#   TTS_MAX_CHUNKS=24      # toplam parça tavanı (aşamalı oynatma)
