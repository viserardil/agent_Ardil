# AgentArdil ortam değişkenleri.
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldur:  cp .env.example .env
# .env asla commit'lenmez (bkz. .gitignore).

# ===========================================================================
# LLM — ana model (triyaj + şeritler). Sağlayıcı-bağımsız; çoğu sağlayıcı
# OpenAI-uyumlu bir endpoint sunar, o yüzden aşağıdaki 3 satırı doldurman yeter.
# ===========================================================================
LLM_API_KEY=buraya_anahtarini_yaz
LLM_MODEL=gpt-4.1
LLM_BASE_URL=https://api.openai.com/v1

# Örnek — Gemini:
#   LLM_MODEL=gemini-2.5-flash
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Örnek — Groq:
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_BASE_URL=https://api.groq.com/openai/v1

# Sağlayıcı structured output'ta json_schema desteklemiyorsa:
#   LLM_STRUCTURED_METHOD=function_calling
# İsteğe bağlı ince ayarlar (varsayılanları vardır):
#   TEMPERATURE=0.1
#   MAX_TOKENS=4096
#   LLM_TIMEOUT=90
#   LLM_MAX_RETRIES=2

# Triyaj için ayrı/daha hızlı bir model kullanmak istersen (boşsa ana model):
#   TRIAGE_MODEL=gpt-4.1-mini

# ===========================================================================
# Araçlar
# ===========================================================================
# web_search aracı (Tavily) — güncel web araması için:
TAVILY_API_KEY=buraya_tavily_anahtarini_yaz

# ===========================================================================
# Ses tanıma (STT) — YEREL, Qwen3-ASR-1.7B (/ws/stt)
# ===========================================================================
# Mikrofon → WebSocket → metin. Tamamen yerel; cloud/anahtar GEREKMEZ. ŞU AN
# SAF (batch) TEST MODUNDA: canlı interim GEÇİCİ DEVRE DIŞI — ses biriktirilir,
# mikrofon durdurulunca TEK SEFERDE deşifre edilir (bkz. agent_core/stt_stream.py).
# Model ilk istekte iner (~4 GB) ve VRAM'de kalır (~4 GB). Değişiklik için
# sunucuyu yeniden başlat.
#
# Model kimliği (varsayılan Qwen3-ASR-1.7B; 0.6B daha küçük/hızlı alternatif):
#   QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
# Deşifre dili (Qwen dil ADI ister, kod değil):
#   STT_STREAM_LANG_NAME=Turkish
# Üretimde en çok bu kadar token (uzun cümlelerde artır):
#   QWEN_ASR_MAX_NEW_TOKENS=256

# ===========================================================================
# Sesli çıktı (TTS) — Fish Audio S2-Pro (CLOUD API)
# ===========================================================================
# "Sesli çıktı" modu açıkken cevap Fish Audio'nun cloud API'siyle seslendirilir.
# Yerel GPU/VRAM GEREKMEZ (S2-Pro 5B parametreli, Fish Audio'nun kendi sunucusunda
# çalışır). Değişiklik için sunucuyu yeniden başlat.
#
# ZORUNLU — fish.audio hesabından al (bkz. fish.audio/app/developers). NOT: API
# kredisi PLATFORM kredisinden AYRIDIR; orada ayrıca yüklenmesi gerekir (402
# Payment Required hatası bu yüzdendir).
FISH_AUDIO_API_KEY=buraya_fish_audio_anahtarini_yaz
#
# backend: s2-pro (varsayılan, en doğal/ifadeli) | s1 | s1-mini | speech-1.6 |
# speech-1.5 | agent-x0. Dil AYRI bir parametre değil — Fish metnin dilini kendi
# tespit eder (Türkçe metin Türkçe seslendirilir).
#   FISH_BACKEND=s2-pro
# Fish Audio platformunda önceden oluşturulmuş bir ses modeli id'si (klonlama).
# Boşsa backend'in varsayılan/genel sesi kullanılır.
#   FISH_REFERENCE_ID=
# Örnekleme ayarları (ileri, genelde dokunmaya gerek yok):
#   FISH_TOP_P=0.7
#   FISH_TEMPERATURE=0.7
#
# --- Parçalama (uzun cevaplar cümle sınırında parçalanır) ---
#   TTS_CHUNK_TOKENS=120   # parça başına ~token bütçesi
#   TTS_MAX_CHUNKS=24      # toplam parça tavanı (aşamalı oynatma)
#
# --- Parça-sınırı temizliği (baş/son sessizlik kırpma + fade in/out) ---
#   TTS_FADE_MS=12  TTS_TRIM_SILENCE=1  TTS_SILENCE_THRESH=0.015  TTS_KEEP_PAD_MS=30
